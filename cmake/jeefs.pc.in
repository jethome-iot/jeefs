prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: jeefs
Description: JEEFS EEPROM filesystem (headers + linked-list file storage)
Version: @PROJECT_VERSION@
Requires.private: zlib
Libs: -L${libdir} -ljeefs -leepromops-memory -ljeefs_header
Cflags: -I${includedir}
